# Environment Variables for Parakh
# Note: Parakh is a client-side Vite application and processes datasets locally in the browser.

# Optional: Anthropic API Key (if external AI endpoints are configured)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: Dataset mirror base URL for data preparation scripts
OLIST_BASE_URL=https://raw.githubusercontent.com/Sangamesh2703/Brazilian-E-Commerce/main

# Optional: Set to 1 to allow automatic dataset downloading during prepare:data script execution
OLIST_ALLOW_DOWNLOAD=0
